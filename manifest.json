{
  "manifest_version": 3,
  "name": "GUI 에이전트",
  "version": "0.1.0",
  "description": "실제 웹페이지에서 화면을 인식하고 클릭, 입력, 스크롤 등 작업을 실행하는 GUI 에이전트입니다.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "sidePanel",
    "activeTab",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GUI 에이전트 패널 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/overlay.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
